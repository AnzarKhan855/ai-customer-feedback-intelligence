{
  "name": "loop-feedback-intelligence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev --turbo",
    "build": "node scripts/prisma-generate.js && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-tests.js",
    "test:live": "tsx scripts/test-live-deployment.ts",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "node scripts/prisma-generate.js",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:prod": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy:prod": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "postinstall": "node scripts/prisma-generate.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "next-auth": "^4.24.8",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
